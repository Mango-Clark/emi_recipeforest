{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "sources": "https://github.com/Mango-Clark/emi_recipeforest"
  },
  "license": "${license}",
  "icon": "icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.github.mango_clark.emirecipeforest.EmiRecipeForest"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "emi": ">=1.1.13+1.21.1 <=1.1.24+1.21.1",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}"
  }
}
